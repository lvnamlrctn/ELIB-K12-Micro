# ── Ports ─────────────────────────────────────────────────────────────────────
API_PORT=8090
NGINX_PORT=8088

# ── Database Provider (SqlServer hoặc PostgreSQL) ───────────────────────────
DATABASE_PROVIDER=SqlServer

# ── SQL Server (Docker container) ────────────────────────────────────────────
MSSQL_SA_PASSWORD=YourStr0ng!Pass
MSSQL_PORT=1433

# ── PostgreSQL (Docker container) ────────────────────────────────────────────
PG_DATABASE=ELIBAPI
PG_USER=elibapi
PG_PASSWORD=YourStr0ng!Pass
PG_PORT=5432

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_KEY=ELIBAPI_JWT_SECRET_KEY_CHANGE_THIS_IN_PRODUCTION_MIN32CHARS
JWT_ISSUER=ELIBAPI
JWT_AUDIENCE=ELIBAPI_CLIENTS
JWT_EXPIRE_HOURS=8

# ── Minio (Object Storage) ──────────────────────────────────────────────────
# SecretKey/Password hỗ trợ 2 cách:
#   Plain text:  MINIO_SECRET_KEY=minioadmin123
#   Mã hóa AES: MINIO_SECRET_KEY=ENC:JLxpCCO9dStw4wvvBAZwYQ==
# (tạo giá trị ENC bằng AesEncryptionHelper.Encrypt("password"))
MINIO_ENDPOINT=103.124.95.249:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=YOUR_MINIO_SECRET
MINIO_BUCKET=elibapi
MINIO_PRIVATE_BUCKET=elibapi-private
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://103.97.134.58:8090/api/public/media

# ── Elasticsearch ────────────────────────────────────────────────────────────
# ES_PASSWORD cũng hỗ trợ ENC: prefix (xem ghi chú Minio ở trên)
ES_URI=http://103.124.95.249:9200
ES_USERNAME=elastic
ES_PASSWORD=YOUR_ES_PASSWORD

# ── LLM (Gemini) ────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# ── Hangfire Dashboard ───────────────────────────────────────────────────────
HANGFIRE_USER=admin
HANGFIRE_PASSWORD=YOUR_HANGFIRE_PASSWORD

# ── Ebook Data Path (host directory for volume mount) ────────────────────────
EBOOK_DATA_PATH=./data/ebook
