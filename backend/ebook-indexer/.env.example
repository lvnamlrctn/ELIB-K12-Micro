# Postgres — có thể copy trực tiếp giá trị PG_PASSWORD dạng ENC:... từ .env.production của .NET
PG_HOST=103.124.95.249
PG_PORT=5432
PG_DATABASE=tvxa
PG_USER=lvnam
PG_PASSWORD=

# MinIO — bucket private chứa file PDF gốc
MINIO_ENDPOINT=103.124.95.249:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_PRIVATE_BUCKET=elibapi-private
MINIO_USE_SSL=false

# Elasticsearch
ES_URI=http://103.124.95.249:9200
ES_USERNAME=elastic
ES_PASSWORD=
ES_CHUNK_INDEX_NAME=ebook_chunks_tn

# Ollama — chạy trên chính máy này nên dùng localhost
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_OCR_MODEL=glm-ocr:latest

# Chunking (khớp mặc định .NET: ChunkSize=500, Overlap=50)
CHUNK_SIZE=500
CHUNK_OVERLAP=50
