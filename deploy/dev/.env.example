# Mẫu cấu hình môi trường DEV. Tạo file thật bằng ./init-env.sh (sinh secret ngẫu nhiên) — KHÔNG điền secret vào file này.

# Tên miền wildcard trỏ về máy chạy stack. Đơn vị truy cập qua <subdomain>.<DEV_DOMAIN>,
# quản trị nền tảng qua quantri.<DEV_DOMAIN>, đăng nhập qua id.<DEV_DOMAIN>.
# Không có DNS riêng: dùng sslip.io theo IP máy, ví dụ 10.0.0.5.sslip.io.
DEV_DOMAIN=

# Issuer OIDC (URL công khai). Bỏ trống = http://id.<DEV_DOMAIN>:<GATEWAY_PORT>/. Sau nginx + TLS: https://<DEV_DOMAIN>/
IDENTITY_ISSUER=

# Origin công khai của host hệ thống và mẫu origin host đơn vị (redirect URI của app Admin).
# Bỏ trống = http://<DEV_DOMAIN>:<GATEWAY_PORT> và http://*.<DEV_DOMAIN>:<GATEWAY_PORT>. Sau nginx + TLS:
#   PUBLIC_ORIGIN=https://<DEV_DOMAIN>   PUBLIC_TENANT_ORIGIN_PATTERN=https://*.<DEV_DOMAIN>
PUBLIC_ORIGIN=
PUBLIC_TENANT_ORIGIN_PATTERN=

# Cổng gateway trên máy chạy; GATEWAY_BIND=127.0.0.1 nếu chỉ muốn vào qua SSH tunnel.
GATEWAY_PORT=8080
GATEWAY_BIND=0.0.0.0
POSTGRES_PORT=5432
RABBITMQ_UI_PORT=15672
MAILPIT_UI_PORT=8025

# ── Secret (init-env.sh sinh) ──────────────────────────────────────────
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
TENANT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
AUDIT_DB_PASSWORD=
MEDIA_DB_PASSWORD=
PATRON_DB_PASSWORD=
MINIO_ROOT_USER=elib
MINIO_ROOT_PASSWORD=
RABBITMQ_USER=elib
RABBITMQ_PASSWORD=
GATEWAY_SIGNING_KEY=
SVC_GATEWAY_SECRET=
SVC_TENANT_SECRET=
SVC_NOTIFICATION_SECRET=
SVC_IDENTITY_SECRET=
SVC_AUDIT_SECRET=
SVC_PATRON_SECRET=
BOOTSTRAP_ADMIN_PASSWORD=

# CAPTCHA/OTP khi tài khoản hệ thống đăng nhập (đơn vị thì theo tham số ADMIN_LOGIN_* của đơn vị). OTP gửi tới BOOTSTRAP_ADMIN_EMAIL.
SYSTEM_LOGIN_CAPTCHA=false
SYSTEM_LOGIN_OTP=false
BOOTSTRAP_ADMIN_EMAIL=

# Image MinIO. Docker Hub không còn cho kéo minio/minio: máy không kéo được thì gắn tag riêng cho image có sẵn
# (docker tag <id> elib/minio:<release>) rồi đặt MINIO_IMAGE=elib/minio:<release>.
MINIO_IMAGE=

# Grafana (trace/log/metrics, tuỳ chọn ~3,7 GB): OTEL_ENDPOINT=http://otel-lgtm:4317 + docker compose --profile observability up -d.
OTEL_ENDPOINT=
GRAFANA_PORT=3000
